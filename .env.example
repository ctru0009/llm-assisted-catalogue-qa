# API
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Web (Vite reads this at dev/build time)
VITE_API_URL=http://localhost:3000

# Intended demo script: set this to the imported n8n Webhook URL.
N8N_WEBHOOK_URL=

# Optional n8n workflow override; the workflow defaults to this local API URL.
CATALOGUE_API_URL=http://127.0.0.1:3000/analyse-product

# API LLM configuration. All three fields are required together for a live
# provider; any missing or blank field selects the unavailable provider.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Stretch only; unused by this MVP.
SHOPIFY_STORE_URL=https://example.invalid
SHOPIFY_ACCESS_TOKEN=
