{
  "name": "Catalogue QA — n8n 1.107.4",
  "description": "Pinned for local n8n 1.107.4. Receives a Shopify-shaped product, maps it to the internal product envelope, calls the local API, and routes PASS/REVIEW/BLOCK to labelled no-op terminals.",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "catalogue-qa",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "catalogue-qa-webhook",
      "name": "Shopify Product Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        260,
        300
      ],
      "webhookId": "catalogue-qa-webhook"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "catalogue-qa-product-mapping",
              "name": "product",
              "value": "={{ { id: String($json.id), title: $json.title, sku: $json.variants[0].sku, price: Number($json.variants[0].price), ...($json.variants[0].compare_at_price === undefined || $json.variants[0].compare_at_price === '' ? {} : { compareAtPrice: Number($json.variants[0].compare_at_price) }), inventory: $json.variants[0].inventory_quantity, category: $json.product_type, vendorCategory: $json.vendor, description: $json.body_html, images: $json.images.map(image => image.src) } }}",
              "type": "object"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "catalogue-qa-map-product",
      "name": "Map Shopify payload to internal product",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CATALOGUE_API_URL || 'http://127.0.0.1:3000/analyse-product' }}",
        "sendHeaders": false,
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { product: $json.product } }}",
        "options": {}
      },
      "id": "catalogue-qa-api-request",
      "name": "POST local API /analyse-product",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        760,
        300
      ],
      "notes": "Defaults to http://127.0.0.1:3000/analyse-product. Set CATALOGUE_API_URL in n8n if the local API is exposed at another address.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "catalogue-qa-pass-condition",
                    "leftValue": "={{ $json.status }}",
                    "rightValue": "PASS",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "PASS"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "catalogue-qa-review-condition",
                    "leftValue": "={{ $json.status }}",
                    "rightValue": "REVIEW",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "REVIEW"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "catalogue-qa-block-condition",
                    "leftValue": "={{ $json.status }}",
                    "rightValue": "BLOCK",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "BLOCK"
            }
          ]
        },
        "options": {
          "fallbackOutput": "none"
        }
      },
